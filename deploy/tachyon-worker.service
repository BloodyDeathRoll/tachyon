# This PC as a Tachyon host: the job loop (spine/worker.py), started at login and kept running.
#
#   python -m spine.worker login <api-url>          # once, writes ~/.tachyon/worker.json
#   cp deploy/tachyon-worker.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now tachyon-worker
#   loginctl enable-linger $USER                    # keeps it running with no session open
#
# Edit WorkingDirectory and ExecStart for another checkout path or a venv's python. A user unit
# has a minimal PATH: add `Environment=PATH=...` with the folders of `claude` and `node` under
# [Service] (deploy/setup-pc.sh writes it). The crontab's
# `week auto` and publish entries stay until phase 4 (docs/CLOUDFLARE-PLAN.md). Logs:
# ~/.tachyon/logs/worker.log and job-<id>.log. Exit 3 is a dead session: it is not restarted;
# run `login` again, then `systemctl --user start tachyon-worker`.

[Unit]
Description=Tachyon worker (job queue host)
After=network-online.target

[Service]
WorkingDirectory=%h/Projects/tachyon
ExecStart="/usr/bin/python3" -m spine.worker run
Restart=always
RestartSec=60
RestartPreventExitStatus=3

[Install]
WantedBy=default.target
