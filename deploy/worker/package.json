{
  "name": "tachyon-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "esbuild src/index.ts --bundle --format=esm --log-level=warning --outfile=.test/index.mjs && node --test",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute tachyon --local --file schema.sql",
    "db:remote": "wrangler d1 execute tachyon --remote --file schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "miniflare": "5.20260921.0-alpha",
    "typescript": "^7.0.2",
    "wrangler": "^4.136.1"
  }
}
